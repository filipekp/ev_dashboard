DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ev_stats
DB_USER=ev_stats
DB_PASS=change_me
APP_NAME="EV Stats"
SESSION_NAME=ev_stats_session
APP_BASE_URL=https://ev.example.cz
APP_DEBUG=0

CRON_HTTP_TOKEN=SEM_DEJ_DLOUHY_NAHODNY_TOKEN

# Bezpečnost relace a ochrana proti brute-force útokům
SESSION_IDLE_SECONDS=43200
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW=900
PASSWORD_RESET_RATE_LIMIT_ATTEMPTS=5
PASSWORD_RESET_RATE_LIMIT_WINDOW=3600
MINIMUM_PASSWORD_LENGTH=12
MAIL_FROM=noreply@example.cz

# Aktualizace aplikace z GitHubu
UPDATE_REPOSITORY=filipekp/ev_dashboard
# release = pouze poslední publikovaný GitHub Release; dev = poslední commit z UPDATE_BRANCH
UPDATE_CHANNEL=release
UPDATE_BRANCH=dev


# Veřejný read-only demo režim
# Demo účet je vytvořen migrací migrate_v19.sql. Uživatel se do něj přihlašuje
# přes tlačítko na landing page, heslo se nepoužívá.
DEMO_ENABLED=true
DEMO_USER_EMAIL=demo@evstats.local

# Veřejná registrace
# ID administrátora, který bude nadřazeným uživatelem nových Správců vozidel.
REGISTRATION_PARENT_ADMIN_ID=1
# Volitelné: jiný e-mail pro notifikace o nových registracích. Prázdné = e-mail administrátora výše.
REGISTRATION_ADMIN_NOTIFY_EMAIL=
# Platnost potvrzovacího odkazu v minutách (výchozí 24 hodin).
REGISTRATION_VERIFICATION_MINUTES=1440

# Google reCAPTCHA v3
# Public/site key z Google reCAPTCHA administrace.
RECAPTCHA_SITE_KEY=replace_with_public_site_key
# Private/secret key. Tento klíč nikdy nevkládejte do veřejného repozitáře.
RECAPTCHA_SECRET_KEY=replace_with_private_secret_key
RECAPTCHA_MINIMUM_SCORE=0.5
# Volitelné dodatečné ověření hostname, např. ev.example.cz
RECAPTCHA_EXPECTED_HOSTNAME=


# Connected Car / OEM connectors
# Vygenerujte: php bin/generate-vehicle-credentials-key.php
VEHICLE_CREDENTIALS_KEY=

# MyŠkoda Public API
SKODA_API_URL=https://public.api.connect.skoda-auto.cz
SKODA_API_TIMEOUT_SECONDS=30
SKODA_SYNC_INTERVAL_SECONDS=600
SKODA_RATE_LIMIT_RESERVE=3

# Kia Europe Vehicle Data API / Pleos (Business User)
# Přístup nejprve schvalte v Pleos Playground -> My Project -> API -> Vehicle Data.
KIA_PLEOS_API_URL=https://api.pleos.ai
KIA_PLEOS_CLIENT_ID=
KIA_PLEOS_CLIENT_SECRET=
# Musí přesně odpovídat Login redirect URL z Pleos API Access Request.
# Pokud zůstane prázdné, použije se APP_BASE_URL/kia-oauth-callback.php
KIA_PLEOS_LOGIN_REDIRECT_URI=
# Musí přesně odpovídat Data sharing agreement redirect URL z Pleos API Access Request.
# Pokud zůstane prázdné, použije se APP_BASE_URL/kia-consent-callback.php
KIA_PLEOS_CONSENT_REDIRECT_URI=
# Náhodný token pro ochranu veřejného Data sharing end callbacku.
# V Pleos zaregistrujte callback např. https://example.cz/kia-data-sharing-ended.php?token=SEM_TOKEN
KIA_PLEOS_SHARING_END_TOKEN=
KIA_PLEOS_LANGUAGE=cs
KIA_PLEOS_TIMEOUT_SECONDS=30
KIA_PLEOS_SYNC_INTERVAL_SECONDS=900
